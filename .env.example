# Acceso al portal de marca (/marca): una contraseña por persona.
# En Vercel: Settings → Environment Variables, para Production y Preview.
# Para probarlo en local, copialas a .env.local. Sin MARCA_USERS, en local el
# portal queda abierto y en producción, cerrado. Detalle en
# src/app/marca/lib/session.ts.
#
# Quién puede entrar. Las entradas se generan con
#   node scripts/marca-usuario.mjs correo@x.com [otro@y.com …]
# (inventa la contraseña y la muestra una sola vez). Separadas por coma, o una
# por línea si el valor va entre comillas.
MARCA_USERS=
# Clave que firma las cookies: node scripts/marca-usuario.mjs --secreto
MARCA_SESSION_SECRET=
# Opcional: cambiarla cierra las sesiones de todos sin tocar contraseñas.
MARCA_SESSION_EPOCH=
